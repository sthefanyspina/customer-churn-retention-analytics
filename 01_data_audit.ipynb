#Analisando valores ausentes
def missing_values_report(df):

    report = pd.DataFrame({
        "missing_count": df.isna().sum(),
        "missing_percentage": (
            df.isna().mean() * 100
        )
    })

    report = report.sort_values(
        "missing_percentage",
        ascending=False
    )

    return report

missing_values_report(customers)
missing_values_report(subscriptions)
missing_values_report(payments)
missing_values_report(usage_metrics)
missing_values_report(support_tickets)
missing_values_report(cancellations)

#verificando duplicidades
def duplicate_report(df, column):

    duplicates = df[column].duplicated().sum()

    print(
        f"Coluna: {column}\n"
        f"Duplicados: {duplicates:,}"
    )

duplicate_report(customers, "customer_id")

duplicate_report(
    subscriptions,
    "subscription_id"
)

duplicate_report(
    payments,
    "payment_id"
)

duplicate_report(
    support_tickets,
    "ticket_id"
)

duplicate_report(
    usage_metrics,
    "usage_id"
)

duplicate_report(
    cancellations,
    "cancellation_id"
)

#Verificando a integridade referencial
def check_foreign_key(
    df,
    column,
    reference_df,
    reference_column
):

    invalid = ~df[column].isin(
        reference_df[reference_column]
    )

    print(
        f"{column}: "
        f"{invalid.sum():,} registros inválidos"
    )

    return df.loc[invalid]

#assinaturas
invalid_subscriptions = check_foreign_key(
    subscriptions,
    "customer_id",
    customers,
    "customer_id"
)

#pagamentos
invalid_payments = check_foreign_key(
    payments,
    "subscription_id",
    subscriptions,
    "subscription_id"
)

#chamados
invalid_tickets = check_foreign_key(
    support_tickets,
    "customer_id",
    customers,
    "customer_id"
)

#utilização
