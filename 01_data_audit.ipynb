#Verificando consistência temporal
#assinaturas
invalid_subscription_dates = subscriptions[
    subscriptions["end_date"].notna()
    &
    (
        subscriptions["end_date"]
        < subscriptions["start_date"]
    )
]

print(
    "Datas inválidas:",
    len(invalid_subscription_dates)
)

#pagamentos
payment_check = payments.merge(
    subscriptions[
        ["subscription_id", "start_date", "end_date"]
    ],
    on="subscription_id",
    how="left"
)

invalid_payment_dates = payment_check[
    (
        payment_check["payment_date"]
        < payment_check["start_date"]
    )
    |
    (
        payment_check["end_date"].notna()
        &
        (
            payment_check["payment_date"]
            > payment_check["end_date"]
        )
    )
]

print(
    "Pagamentos com datas inválidas:",
    len(invalid_payment_dates)
)

#cancelamentos
cancel_check = cancellations.merge(
    subscriptions[
        ["subscription_id", "start_date", "end_date"]
    ],
    on="subscription_id",
    how="left"
)

invalid_cancel_dates = cancel_check[
    cancel_check["cancellation_date"]
    < cancel_check["start_date"]
]

print(
    "Cancelamentos temporalmente inválidos:",
    len(invalid_cancel_dates)
)

#data de corte
ANALYSIS_END_DATE = pd.Timestamp(
    "2025-12-31"
)

#status atual vs status historico
subscriptions["active_at_cutoff"] = (
    subscriptions["start_date"]
    <= ANALYSIS_END_DATE
) & (
    subscriptions["end_date"].isna()
    |
    (
        subscriptions["end_date"]
        > ANALYSIS_END_DATE
    )
)



