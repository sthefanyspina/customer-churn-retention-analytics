#Churn de assinatura histórico
total_subscriptions = len(
    subscriptions
)

cancelled_subscriptions = (
    subscriptions["status"]
    == "Cancelled"
).sum()

subscription_churn_rate = (
    cancelled_subscriptions
    / total_subscriptions
)

print(
    f"Total de assinaturas: "
    f"{total_subscriptions:,}"
)

print(
    f"Assinaturas canceladas: "
    f"{cancelled_subscriptions:,}"
)

print(
    f"Churn histórico de assinatura: "
    f"{subscription_churn_rate:.2%}"
)

#Clientes que já cancelaram alguma assinatura
customer_churn_summary = (
    customer_analytics[
        "has_ever_cancelled"
    ].mean()
)

print(
    f"Clientes que já cancelaram pelo menos "
    f"uma assinatura: "
    f"{customer_churn_summary:.2%}"
)

#Clientes que atualmente possuem uma assinatura
customers_with_active_subscription = (
    customer_analytics[
        "currently_has_active_subscription"
    ].sum()
)

customers_without_active_subscription = (
    (
        customer_analytics[
            "currently_has_active_subscription"
        ] == 0
    ).sum()
)

print(
    "Clientes com assinatura ativa:",
    customers_with_active_subscription
)

print(
    "Clientes sem assinatura ativa:",
    customers_without_active_subscription
)

#Churn por plano
churn_by_plan = (
    subscription_analysis
    .groupby("plan_name")
    .agg(

        total_subscriptions=(
            "subscription_id",
            "count"
        ),

        cancelled_subscriptions=(
            "is_churned",
            "sum"
        )

    )
    .reset_index()
)

churn_by_plan["historical_cancellation_ratio"] = (
    churn_by_plan[
        "cancelled_subscriptions"
    ]
    /
    churn_by_plan[
        "total_subscriptions"
    ]
)

churn_by_plan = churn_by_plan.sort_values(
    "historical_cancellation_ratio",
    ascending=False
)

churn_by_plan

plt.figure(figsize=(10, 6))

sns.barplot(
    data=churn_by_plan,
    x="plan_name",
    y="historical_cancellation_ratio"
)

plt.title(
    "Proporção Histórica de Cancelamento por Plano"
)

plt.xlabel("Plano")
plt.ylabel("Proporção cancelada")

plt.tight_layout()
plt.show()

