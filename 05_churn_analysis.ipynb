#Receita recorrente associada ao churn
cancelled_subscription_analysis = (
    subscription_analysis[
        subscription_analysis["is_churned"] == 1
    ].copy()
)

cancelled_mrr = (
    cancelled_subscription_analysis[
        "mrr"
    ].sum()
)

cancelled_arr = (
    cancelled_subscription_analysis[
        "arr"
    ].sum()
)

print(
    f"MRR associado às assinaturas canceladas: "
    f"R$ {cancelled_mrr:,.2f}"
)

print(
    f"ARR associado às assinaturas canceladas: "
    f"R$ {cancelled_arr:,.2f}"
)


#Receita associada ao churn por plano
lost_revenue_by_plan = (
    cancelled_subscription_analysis
    .groupby("plan_name")
    .agg(

        cancelled_subscriptions=(
            "subscription_id",
            "count"
        ),

        mrr_associated_with_cancelled=(
            "mrr",
            "sum"
        ),

        arr_associated_with_cancelled=(
            "arr",
            "sum"
        )

    )
    .reset_index()
)

lost_revenue_by_plan.sort_values(
    "mrr_associated_with_cancelled",
    ascending=False
)

plt.figure(figsize=(10, 6))

sns.barplot(
    data=lost_revenue_by_plan,
    x="plan_name",
    y="mrr_associated_with_cancelled"
)

plt.title(
    "MRR Associado às Assinaturas Canceladas por Plano"
)

plt.xlabel("Plano")
plt.ylabel("MRR associado ao churn")

plt.tight_layout()
plt.show()


