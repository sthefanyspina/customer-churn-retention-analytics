#Distribuição dos planos
plan_distribution = (
    subscription_analysis
    .groupby("plan_name")
    .size()
    .reset_index(name="subscriptions")
    .sort_values(
        "subscriptions",
        ascending=False
    )
)

plan_distribution

plt.figure(figsize=(10, 6))

sns.barplot(
    data=plan_distribution,
    x="plan_name",
    y="subscriptions"
)

plt.title(
    "Distribuição de Assinaturas por Plano"
)

plt.xlabel("Plano")
plt.ylabel("Quantidade de assinaturas")

plt.tight_layout()
plt.show()

#Distribuição por ciclo de cobrança
billing_distribution = (
    subscription_analysis[
        "billing_cycle"
    ].value_counts()
)

billing_distribution

plt.figure(figsize=(8, 6))

billing_distribution.plot(
    kind="bar"
)

plt.title(
    "Distribuição de Assinaturas por Ciclo de Cobrança"
)

plt.xlabel("Ciclo")
plt.ylabel("Quantidade")

plt.xticks(rotation=0)

plt.tight_layout()
plt.show()

