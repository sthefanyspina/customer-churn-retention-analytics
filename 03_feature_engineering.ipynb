#Incorporando os dados dos planos
subscription_analysis = subscriptions.merge(
    plans,
    on="plan_id",
    how="left"
)

subscription_analysis = subscription_analysis.merge(
    customers[
        [
            "customer_id",
            "region",
            "industry",
            "registration_date"
        ]
    ],
    on="customer_id",
    how="left"
)

subscription_analysis.head()

#Criando a variável churn
subscription_analysis["is_churned"] = (
    subscription_analysis["status"]
    == "Cancelled"
).astype(int)

#criando tempo de permanencia
subscription_analysis["effective_end_date"] = (
    subscription_analysis["end_date"]
    .fillna(ANALYSIS_END_DATE)
)

#calculando duração
subscription_analysis["subscription_days"] = (
    subscription_analysis["effective_end_date"]
    - subscription_analysis["start_date"]
).dt.days

#convertendo para meses
subscription_analysis["subscription_months"] = (
    subscription_analysis["subscription_days"]
    / 30.4375
)

#verificando a distribuição
subscription_analysis[
    "subscription_months"
].describe()

plt.figure(figsize=(10, 6))

sns.histplot(
    data=subscription_analysis,
    x="subscription_months",
    bins=40,
    kde=True
)

plt.title(
    "Distribuição do Tempo de Permanência"
)

plt.xlabel("Meses de assinatura")
plt.ylabel("Quantidade de assinaturas")

plt.tight_layout()
plt.show()

#Criando MRR e ARR
subscription_analysis["mrr"] = np.where(
    subscription_analysis["billing_cycle"] == "Annual",
    subscription_analysis["annual_price"] / 12,
    subscription_analysis["monthly_price"]
)

subscription_analysis["arr"] = (
    subscription_analysis["mrr"] * 12
)

subscription_analysis[
    [
        "plan_name",
        "billing_cycle",
        "monthly_price",
        "annual_price",
        "mrr",
        "arr"
    ]
].head(20)

#Incorporando os indicadores de pagamento
#Agregamento de pagamentos
payment_metrics = payments.groupby(
    "subscription_id"
).agg(

    total_payment_attempts=(
        "payment_id",
        "count"
    ),

    total_payment_amount=(
        "amount",
        "sum"
    )

).reset_index()

#quantidades por status
payment_status_metrics = (
    payments.groupby("subscription_id")
    .agg(

        paid_count=(
            "status",
            lambda x: (x == "Paid").sum()
        ),

        failed_count=(
            "status",
            lambda x: (x == "Failed").sum()
        ),

        pending_count=(
            "status",
            lambda x: (x == "Pending").sum()
        )

    )
    .reset_index()
)

payment_metrics = payment_metrics.merge(
    payment_status_metrics,
    on="subscription_id",
    how="left"
)

#calculando taxa de falhas
payment_metrics["payment_failure_rate"] = (
    payment_metrics["failed_count"]
    / payment_metrics["total_payment_attempts"]
)

#tratando divisão por zero
payment_metrics["payment_failure_rate"] = (
    payment_metrics["payment_failure_rate"]
    .fillna(0)
)

#incorporando base analitica
subscription_analysis = subscription_analysis.merge(
    payment_metrics,
    on="subscription_id",
    how="left"
)

#tratando registros sem pagamentos
payment_columns = [
    "total_payment_attempts",
    "total_payment_amount",
    "paid_count",
    "failed_count",
    "pending_count",
    "payment_failure_rate"
]

subscription_analysis[payment_columns] = (
    subscription_analysis[payment_columns]
    .fillna(0)
)

#Criando uma classificação exploratória de pagamentos
subscription_analysis["payment_failure_segment"] = np.select(

    [
        subscription_analysis[
            "payment_failure_rate"
        ] == 0,

        subscription_analysis[
            "payment_failure_rate"
        ] <= 0.10,

        subscription_analysis[
            "payment_failure_rate"
        ] > 0.10
    ],

    [
        "No Failures",
        "Low Failure Rate",
        "Higher Failure Rate"
    ],

    default="Unknown"

)

#Incorporando métricas de utilização
usage_agg = usage_metrics.groupby(
    "customer_id"
).agg(

    usage_records=(
        "usage_id",
        "count"
    ),

    total_logins=(
        "login_count",
        "sum"
    ),

    avg_logins_per_record=(
        "login_count",
        "mean"
    ),

    total_active_minutes=(
        "active_minutes",
        "sum"
    ),

    avg_active_minutes=(
        "active_minutes",
        "mean"
    ),

    median_active_minutes=(
        "active_minutes",
        "median"
    )

).reset_index()

subscription_analysis = subscription_analysis.merge(
    usage_agg,
    on="customer_id",
    how="left"
)

#Tratando ausência de utilização registrada:
usage_columns = [
    "usage_records",
    "total_logins",
    "avg_logins_per_record",
    "total_active_minutes",
    "avg_active_minutes",
    "median_active_minutes"
]

subscription_analysis[usage_columns] = (
    subscription_analysis[usage_columns]
    .fillna(0)
)

#Criando frequência de utilização
usage_frequency = usage_metrics.groupby(
    "customer_id"
).agg(

    distinct_usage_days=(
        "usage_date",
        "nunique"
    ),

    first_usage_date=(
        "usage_date",
        "min"
    ),

    last_usage_date=(
        "usage_date",
        "max"
    )

).reset_index()

#intervalo entre a primeira e a última atividade
usage_frequency["observed_usage_span_days"] = (
    usage_frequency["last_usage_date"]
    - usage_frequency["first_usage_date"]
).dt.days

#frequência média observada
usage_frequency["observed_usage_frequency"] = np.where(

    usage_frequency[
        "observed_usage_span_days"
    ] > 0,

    usage_frequency[
        "distinct_usage_days"
    ]
    /
    usage_frequency[
        "observed_usage_span_days"
    ],

    np.nan

)

#Quantificando os recursos utilizados
usage_metrics["features_count"] = (
    usage_metrics["features_used"]
    .str.split("|")
    .str.len()
)

usage_metrics[
    [
        "customer_id",
        "usage_date",
        "features_used",
        "features_count"
    ]
].head()

#agregar por cliente
feature_usage_count = usage_metrics.groupby(
    "customer_id"
).agg(

    avg_features_per_record=(
        "features_count",
        "mean"
    ),

    total_feature_instances=(
        "features_count",
        "sum"
    )

).reset_index()

#Contagem de recursos distintos
feature_lists = usage_metrics[
    ["customer_id", "features_used"]
].copy()

feature_lists["feature_list"] = (
    feature_lists["features_used"]
    .str.split("|")
)

feature_lists = feature_lists.explode(
    "feature_list"
)

distinct_features = feature_lists.groupby(
    "customer_id"
).agg(

    distinct_features_used=(
        "feature_list",
        "nunique"
    )

).reset_index()

#Incorporando chamados de suporte
support_agg = support_tickets.groupby(
    "customer_id"
).agg(

    total_tickets=(
        "ticket_id",
        "count"
    ),

    avg_resolution_time=(
        "resolution_time",
        "mean"
    ),

    median_resolution_time=(
        "resolution_time",
        "median"
    )

).reset_index()

#quantidade de chamados por categoria
ticket_categories = support_tickets.pivot_table(

    index="customer_id",

    columns="category",

    values="ticket_id",

    aggfunc="count",

    fill_value=0

).reset_index()

#Unindo os indicadores
subscription_analysis = subscription_analysis.merge(
    support_agg,
    on="customer_id",
    how="left"
)

#Tratando ausência de chamados
subscription_analysis[
    [
        "total_tickets",
        "avg_resolution_time",
        "median_resolution_time"
    ]
] = subscription_analysis[
    [
        "total_tickets",
        "avg_resolution_time",
        "median_resolution_time"
    ].fillna(0)
]

#Incorporando métricas de utilização de recursos
subscription_analysis = subscription_analysis.merge(
    distinct_features,
    on="customer_id",
    how="left"
)

#Incorporando as métricas médias
subscription_analysis = subscription_analysis.merge(
    feature_usage_count,
    on="customer_id",
    how="left"
)

#Tratamento de ausência
feature_columns = [
    "distinct_features_used",
    "avg_features_per_record",
    "total_feature_instances"
]

subscription_analysis[feature_columns] = (
    subscription_analysis[feature_columns]
    .fillna(0)
)

#Criando indicadores de cliente
customer_subscription_metrics = subscriptions.groupby(
    "customer_id"
).agg(

    total_subscriptions=(
        "subscription_id",
        "count"
    ),

    cancelled_subscriptions=(
        "status",
        lambda x: (x == "Cancelled").sum()
    ),

    active_subscriptions=(
        "status",
        lambda x: (x == "Active").sum()
    ),

    first_subscription_date=(
        "start_date",
        "min"
    ),

    last_subscription_start=(
        "start_date",
        "max"
    )

).reset_index()

#indicador de cancelamento histórico
customer_subscription_metrics[
    "has_ever_cancelled"
] = (

    customer_subscription_metrics[
        "cancelled_subscriptions"
    ] > 0

).astype(int)

customer_subscription_metrics[
    "currently_has_active_subscription"
] = (

    customer_subscription_metrics[
        "active_subscriptions"
    ] > 0

).astype(int)

#Construindo customer_analytics
customer_analytics = customers.merge(

    customer_subscription_metrics,

    on="customer_id",

    how="left"

)

customer_analytics = customer_analytics.merge(
    usage_agg,
    on="customer_id",
    how="left"
)

#Incorporamos frequência
customer_analytics = customer_analytics.merge(
    usage_frequency,
    on="customer_id",
    how="left"
)

#Incorporamos diversidade de recursos
customer_analytics = customer_analytics.merge(
    distinct_features,
    on="customer_id",
    how="left"
)

#Incorporamos chamados
customer_analytics = customer_analytics.merge(
    support_agg,
    on="customer_id",
    how="left"
)

#Tratando ausencia de dados
numeric_columns = [
    "total_subscriptions",
    "cancelled_subscriptions",
    "active_subscriptions",
    "has_ever_cancelled",
    "currently_has_active_subscription",
    "usage_records",
    "total_logins",
    "avg_logins_per_record",
    "total_active_minutes",
    "avg_active_minutes",
    "median_active_minutes",
    "distinct_usage_days",
    "distinct_features_used",
    "total_tickets",
    "avg_resolution_time",
    "median_resolution_time"
]

for column in numeric_columns:

    if column in customer_analytics.columns:

        customer_analytics[column] = (
            customer_analytics[column]
            .fillna(0)
        )

#Criando uma classificação de utilização
customer_analytics["usage_segment"] = pd.cut(

    customer_analytics[
        "distinct_usage_days"
    ],

    bins=[
        -1,
        5,
        20,
        60,
        np.inf
    ],

    labels=[
        "Very Low Observed Activity",
        "Low Observed Activity",
        "Moderate Observed Activity",
        "High Observed Activity"
    ]

)

customer_analytics[
    "usage_segment"
].value_counts()

plt.figure(figsize=(10, 6))

sns.countplot(
    data=customer_analytics,
    x="usage_segment",
    order=[
        "Very Low Observed Activity",
        "Low Observed Activity",
        "Moderate Observed Activity",
        "High Observed Activity"
    ]
)

plt.title(
    "Distribuição dos Clientes por Segmento de Utilização Observada"
)

plt.xlabel("Segmento")
plt.ylabel("Clientes")

plt.xticks(rotation=25)

plt.tight_layout()
plt.show()

#Salvando as bases analíticas
PROCESSED_DIR = Path("../data/processed")

PROCESSED_DIR.mkdir(
    parents=True,
    exist_ok=True
)

subscription_analysis.to_csv(
    PROCESSED_DIR / "subscription_analytics.csv",
    index=False
)

customer_analytics.to_csv(
    PROCESSED_DIR / "customer_analytics.csv",
    index=False
)

